# Port the server listens on (default 3000)
PORT=3000

# How often to check for new releases, in minutes (default 60)
FETCH_INTERVAL_MINUTES=60

# MyMemory translation email (optional — raises free limit from 5k to 10k chars/day)
# Register free at: https://mymemory.translated.net/
MYMEMORY_EMAIL=

# LibreTranslate: if you self-host it, put the URL here (see README)
# Leave empty to use MyMemory instead
LIBRETRANSLATE_URL=
